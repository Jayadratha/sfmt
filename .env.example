# copy to .env and `source .env` before training
export SFMT_DATA=/path/to/data                    # root containing amass/ smplh/ Rignet/ Mixamo/
export SFMT_MIXAMO_SIMPLIFY_PATH=$SFMT_DATA/Mixamo/Mixamo_simplify_new   # npz/, motion60/ (or motion20/), our_character_{train,test}.txt
export SFMT_SMPLH_PATH=$SFMT_DATA/smplh
export SFMT_AMASS_PATH=$SFMT_DATA/amass/processed
export SFMT_RIGNET_PATH=$SFMT_DATA/Rignet
export SFMT_LOG_DIR=./runs
